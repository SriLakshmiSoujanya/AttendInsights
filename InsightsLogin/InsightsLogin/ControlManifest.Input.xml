<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="AttendInsights"
           constructor="StudentDashboard"
           version="9.0.0"
           display-name-key="StudentDashboard"
           description-key="Technical Hub Dynamic Student Dashboard"
           control-type="standard">

    <property name="RollNumber"
              display-name-key="RollNumber"
              description-key="Student Roll Number"
              of-type="SingleLine.Text"
              usage="bound"
              required="false" />

    <property name="StudentName"
              display-name-key="StudentName"
              description-key="Student Full Name"
              of-type="SingleLine.Text"
              usage="bound"
              required="false" />

    <property name="Sessions"
              display-name-key="Sessions"
              description-key="Total Sessions"
              of-type="Whole.None"
              usage="bound"
              required="false" />

    <property name="Attended"
              display-name-key="Attended"
              description-key="Attended Sessions"
              of-type="Whole.None"
              usage="bound"
              required="false" />

    <property name="Percentage"
              display-name-key="Percentage"
              description-key="Attendance Percentage"
              of-type="Decimal"
              usage="bound"
              required="false" />

    <property name="AlertMessage"
              display-name-key="AlertMessage"
              description-key="Dynamic Alerts"
              of-type="Multiple"
              usage="bound"
              required="false" />

    <resources>
      <code path="index.ts" order="1"/>
    </resources>

    <feature-usage>
      <uses-feature name="Utility" required="false"/>
    </feature-usage>

  </control>
</manifest>