<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="AttendInsights"
           constructor="AdminDashboard"
           version="9.0.0"
           display-name-key="AdminDashboard"
           description-key="Technical Hub Admin Dashboard with AI Chatbot"
           control-type="standard">

    <!-- Pass your Anthropic API key from Power Apps environment variable -->
    <property name="ApiKey"
              display-name-key="ApiKey"
              description-key="Anthropic API Key for AI Chatbot"
              of-type="SingleLine.Text"
              usage="bound"
              required="false" />

    <!-- Optional: Admin name from Power Apps login -->
    <property name="AdminName"
              display-name-key="AdminName"
              description-key="Logged In Admin Name"
              of-type="SingleLine.Text"
              usage="bound"
              required="false" />

    <resources>
      <code path="index.ts" order="1"/>
    </resources>

    <feature-usage>
      <uses-feature name="Utility" required="false"/>
    </feature-usage>
  </control>
</manifest>